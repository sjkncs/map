{
  "compilerOptions": {
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "paths": {
      "@/*": ["./src/*"],
      "@root/*": ["../*"]
    }
  },
  "include": ["**/*.ts", "**/*.js"],
  "exclude": ["public"]
}
