{
  "compilerOptions": {
    "lib": ["ES2024"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"],
      "@root/*": ["../*"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["public"]
}
